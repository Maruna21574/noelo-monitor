# Databáza
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=noelo_monitor
DB_USER=
DB_PASSWORD=

# Testovacia databaza (pouziva PHPUnit)
DB_TEST_NAME=noelo_monitor_test

# XML feed objednávok
ORDER_FEED_URL=
ORDER_FEED_USERNAME=
ORDER_FEED_PASSWORD=
ORDER_FEED_TIMEOUT_SECONDS=15
ORDER_FEED_MAX_ATTEMPTS=3

# Skladový feed (bude doplnené neskôr)
STOCK_FEED_URL=

# Fio banka - read-only API
# NIKDY necommitovať skutočnú hodnotu, nesmie sa objaviť v logoch ani chybách
FIO_API_TOKEN=
FIO_LOOKBACK_DAYS=10
FIO_TIMEOUT_SECONDS=20
FIO_MAX_ATTEMPTS=3

# SMTP / PHPMailer
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Noelo Monitor

# Príjemcovia denného reportu (oddelené čiarkou)
REPORT_EMAIL_RECIPIENTS=

# Automatické pripomienky nezaplatenia (5+ dní) - posielajú maily REÁLNYM zákazníkom
# MODE: off (predvolené) | dry-run (nič sa neodošle, len sa vypíše komu by šlo) | live
PAYMENT_REMINDER_MODE=off
# Adresa shopu, ktorá odošle mail; {id} sa nahradí ID objednávky (3014238270 -> 238270)
PAYMENT_REMINDER_URL=https://www.noelo.sk/core/service.php?action=orderActions&id={id}&type=9
PAYMENT_REMINDER_ID_PREFIX=3014
PAYMENT_REMINDER_MAX_PER_RUN=20
PAYMENT_REMINDER_TIMEOUT_SECONDS=20
# Len ak adresa vyžaduje Basic auth
PAYMENT_REMINDER_BASIC_USERNAME=
PAYMENT_REMINDER_BASIC_PASSWORD=

# Časové pásmo
APP_TIMEZONE=Europe/Bratislava

# Verejná URL administrácie (pouzije sa ako odkaz v pätičke e-mailu)
APP_URL=
