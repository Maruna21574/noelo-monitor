{
    "name": "noelo/monitor",
    "description": "Interna aplikacia pre kontrolu objednavok, skladu, rezervacii a platieb e-shopu noelo.sk",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Noelo\\Monitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Noelo\\Monitor\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
